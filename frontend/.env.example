# Optional API override. Default uses the same-origin /api/v1 proxy.
VITE_API_BASE_URL=/api/v1
# Only enable for an isolated public/demo build; never for production data.
VITE_PREVIEW_MODE=false
# Optional XYZ imagery provider, subject to provider attribution and terms.
VITE_SATELLITE_TILES=
VITE_SATELLITE_ATTRIBUTION=
